{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/kopie-von-polieren",
      "destination": "/elite-endstufe",
      "statusCode": 301
    },
    {
      "source": "/kopie-von-innenreinigung",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/services-7",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/kopie-von-versiegeln-1",
      "destination": "/elite-endstufe",
      "statusCode": 301
    },
    {
      "source": "/kopie-von-versiegeln",
      "destination": "/elite-endstufe",
      "statusCode": 301
    },
    {
      "source": "/jetzt-buchen",
      "destination": "/buchen",
      "statusCode": 301
    },
    {
      "source": "/s-projects-side-by-side",
      "destination": "/projekte",
      "statusCode": 301
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/fonts/(.*).woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).(webp|avif|png|jpg|jpeg|svg|ico|gif|mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com; connect-src 'self' https://api.cloudinary.com https://hook.eu1.make.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
